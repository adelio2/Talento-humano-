# ==============================================================================
# .gitignore - Proyecto Nexa Servicios: Gestión de Talento Humano
# ==============================================================================

# Archivos temporales y de bloqueo de Microsoft Office
~$*.docx
~$*.xlsx
~$*.pptx
*.tmp

# Archivos del sistema operativo (Windows, macOS, Linux)
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
.Spotlight-V100
.Trashes

# Entorno, secretos y credenciales locales
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem
*.pfx
secrets/
credentials.json

# Permitir explícitamente plantillas de variables de entorno
!.env.example

# IDEs y editores de código (ajustes locales de usuario)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
